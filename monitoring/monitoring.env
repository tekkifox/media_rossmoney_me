# Monitoring stack environment variables
#
# Passed to the stack with `env_file` in monitoring/compose.yaml, and used for
# Compose interpolation. In Portainer, deploy the stack with this file in the
# same directory as the compose file, or paste the values into the stack's
# Environment variables section.
#
#   docker compose --env-file monitoring/monitoring.env -f monitoring/compose.yaml up -d

# GHCR image namespace. Defaults to the GitHub repo owner (tekkifox).
IMAGE_NAMESPACE=tekkifox

# UID/GID for the reports volume, used by the reports-init script.
# Docker creates named volumes root-owned, so this chowns them before
# the scanner writes or nginx reads.
REPORT_UID=1001
REPORT_GID=1001

# Lynis report paths, relative to the shared reports volume.
# The input is written by the host Lynis cron; the output is the HTML
# report rendered by the converter and served by the dashboard.
REPORT_PATH=/reports/lynis-report.dat
OUTPUT_PATH=/reports/lynis-report.html
