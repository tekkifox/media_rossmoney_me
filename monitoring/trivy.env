# Trivy scan stack environment variables
#
# Passed to the stack with `env_file` in monitoring/trivy-compose.yaml, and
# used for Compose interpolation. In Portainer, deploy the stack with this file
# in the same directory as the compose file, or paste the values into the
# stack's Environment variables section.
#
#   docker compose --env-file monitoring/trivy.env -f monitoring/trivy-compose.yaml up -d

# GHCR image namespace. Defaults to the GitHub repo owner (tekkifox).
IMAGE_NAMESPACE=tekkifox

# Trivy server resource limits
TRIVY_CPUS=2.0
TRIVY_MEMORY=2G

# Severity threshold for the console summary of the host OS scan
TRIVY_SCAN_SEVERITY=HIGH,CRITICAL

# Skip unfixed vulnerabilities in scan reports
TRIVY_SCAN_IGNORE_UNFIXED=true

# Trivy server address for client scans.
#
# Deliberately NOT set here. This file is shared by every service in
# trivy-compose.yaml, including the `trivy server` process itself, so a
# TRIVY_SERVER value in the shared env would be inherited by the server.
# The cron passes it per-exec instead:
#
#   docker exec -e TRIVY_SERVER=http://127.0.0.1:8080 trivy /scan.sh
#
# Keep that address in step with the `trivy server --listen` value in
# monitoring/trivy-compose.yaml. The scanner must talk to the server because
# the server holds the /var/cache/trivy lock; a separate client sharing the
# same cache aborts with "Failed to acquire cache or database lock".

# Space-separated host paths to skip during OS scan (media trees, pseudo-fs,
# and container data such as /host/home, which the OS scan does not need).
TRIVY_SKIP_DIRS=/host/home /host/var/lib/docker /host/proc /host/sys /host/dev /host/run /host/mnt /host/backups

# Extra images to scan (in addition to daemon images)
TRIVY_SCAN_IMAGES=

# Emit CycloneDX and SPDX SBOMs alongside vulnerability reports
TRIVY_SCAN_SBOM=true

# Where the scan job writes its reports
TRIVY_SCAN_REPORT_DIR=/reports

# Read-only Docker API via the socket proxy, not the raw socket. The proxy
# denies POST/EXEC, so a compromised scanner cannot mutate the host.
TRIVY_DOCKER_API=http://docker-api:2375

# Enable Docker API endpoints needed by the Trivy scanner (list images, ping)
PING=1
VERSION=1
IMAGES=1
CONTAINERS=1
